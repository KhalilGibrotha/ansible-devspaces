NAMESPACE=devspaces
WORKSPACE_PVC=replace-with-workspace-pvc
WORKSPACE_MOUNT_PATH=/workspace
ANSIBLE_REPO_DIR=/workspace/ansible-devspaces
TOOLKIT_DIR=/workspace/dac-toolkit
INPUT_MARKDOWN=/workspace/content/docs/sample.md
OUTPUT_DOCX=/workspace/content/exports/sample.docx
ASSETS_DIR=/workspace/content/exports/generated-diagrams
REWRITTEN_MARKDOWN=/tmp/rendered-with-kroki.md
ORG_YAML=
LOGO_PATH=
KROKI_URL=http://kroki:8000
JOB_NAME=docx-render
JOB_TIMEOUT=600s
PYTHON_IMAGE=python:3.13-slim
KROKI_IMAGE=yuzutech/kroki:0.28.0
